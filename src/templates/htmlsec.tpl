<section class="decl dkind-{kind} {decl-classes}" id="{id}">
  <span class="dtype">{decl-vis format="{decl-vis} "}{decl-type}</span>
  {name format="<h2>{name}</h2>"}
  {path format="<div class=\"path\">{path}</div>"}
  {sig format="<pre class=\"sig\"><code>{sig}</code></pre>"}
  {comment format="<div class=\"comment\">{comment}</div>"}
  {directories-heading format="<h4 class=\"dirs-heading\">{directories-heading}</h4>"}
  {directories format="<div class=\"dirs cols\">{directories}</div>"}
  {files-heading format="<h4 class=\"files-heading\">{files-heading}</h4>"}
  {files format="<div class=\"files cols\">{files}</div>"}
  {fields-heading format="<h4 class=\"fields-heading\">{fields-heading}</h4>"}
  {fields format="<div class=\"fields\">{fields}</div>"}
  {params-heading format="<h4 class=\"params-heading\">{params-heading}</h4>"}
  {params format="<div class=\"params\">{params}</div>"}
  {namespaces-heading format="<h4 class=\"ns-heading\">{namespaces-heading}</h4>"}
  {namespaces format="<div class=\"ns cols\">{namespaces}</div>"}
  {structs-heading format="<h4 class=\"structs-heading\">{structs-heading}</h4>"}
  {structs format="<div class=\"structs cols\">{structs}</div>"}
  {types-heading format="<h4 class=\"types-heading\">{types-heading}</h4>"}
  {types format="<div class=\"types cols\">{types}</div>"}
  {values-heading format="<h4 class=\"values-heading\">{values-heading}</h4>"}
  {values format="<div class=\"values\">{values}</div>"}
  {functions-heading format="<h4 class=\"funcs-heading\">{functions-heading}</h4>"}
  {functions format="<div class=\"funcs\">{functions}</div>"}
  {errors-heading format="<h4 class=\"errors-heading\">{errors-heading}</h4>"}
  {errors format="<div class=\"errors\">{errors}</div>"}
  {tests-heading format="<h4 class=\"tests-heading\">{tests-heading}</h4>"}
  {tests format="<div class=\"tests\">{tests}</div>"}
  {source-heading format="<h4 class=\"source-heading\">{source-heading}</h4>"}
  {source format="<div class=\"source\">{source}</div>"}
  {file-heading format="<h4 class=\"file-heading\">{file-heading}</h4>"}
  {file format="<div class=\"file\">{file}</div>"}
</section>
