<section class="decl decl-{kind}" id="{id}">
  {name format="<h2>{name}</h2>"}
  {path format="<div class=\"path\">{path}</div>"}
  {sig format="<pre class=\"sig\"><code>{sig}</code></pre>"}
  {file-heading format="<h4 class=\"file-heading\">{file-heading}</h4>"}
  {location format="<div class=\"location\">{location}</div>"}
  {comment}
  {code-heading format="<h4 class=\"code-heading\">{code-heading}</h4>"}
  {source}
</section>
